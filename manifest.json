{
  "manifest_version": 3,
  "name": "USD to INR Converter",
  "version": "1.0",
  "description": "Hover over dollar amounts to see INR conversion",
  "permissions": ["storage"],
  "host_permissions": ["https://api.exchangerate-api.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
